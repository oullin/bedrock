{
  "name": "@bedrock/app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vite build && sh -c 'mkdir -p ../bin && go build -o ../bin/http ./public && go build -o ../bin/cli ./cmd/cli && mkdir -p ../../storage/.turbo/dist/demo && touch ../../storage/.turbo/dist/demo/.build-stamp'",
    "dev": "vite",
    "dev:go": "go run ./public",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../storage/.cache/coverage/go/demo && go test ./... -coverprofile=../../storage/.cache/coverage/go/demo/coverage.out'",
    "typecheck": "vue-tsc --noEmit && go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  },
  "dependencies": {
    "@inertiajs/vue3": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.0.0"
  }
}
