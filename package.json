{
  "name": "gollin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "preinstall": "sh services/scripts/enforce-pnpm.sh",
    "build": "turbo run build && make go-build",
    "compliance": "BEDROCK_COMPLIANCE_SKIP_FRESHNESS=1 services/scripts/laravel-compliance.sh check",
    "compliance:freshness": "services/scripts/laravel-compliance.sh check-freshness",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck && make vet",
    "test": "turbo run test && make go-test && pnpm run compliance",
    "test:coverage": "turbo run test:coverage && make go-coverage && pnpm run compliance",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "oxfmt": "^0.21.0",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
