{
  "name": "gollin",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "preinstall": "node packages/scripts/enforce-pnpm.mjs",
    "bootstrap:illuminate": "node packages/scripts/bootstrap-illuminate.mjs",
    "sync:laravel": "node packages/scripts/sync-laravel-upstream.mjs",
    "build": "turbo run build --cache-dir=packages/storage/.turbo",
    "dev": "turbo run dev --cache-dir=packages/storage/.turbo",
    "typecheck": "turbo run typecheck --cache-dir=packages/storage/.turbo",
    "test": "turbo run test --cache-dir=packages/storage/.turbo",
    "test:coverage": "turbo run test:coverage --cache-dir=packages/storage/.turbo",
    "fmt": "turbo run fmt --cache-dir=packages/storage/.turbo",
    "fmt:check": "turbo run fmt:check --cache-dir=packages/storage/.turbo"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "oxfmt": "^0.21.0",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
