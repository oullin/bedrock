{
  "name": "@gollin/illuminate-json-schema",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../storage/dist/json-schema && go build ./... && touch ../../storage/dist/json-schema/.build-stamp'",
    "dev": "go test ./... -count=1",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../storage/coverage/go/json-schema && go test ./... -coverprofile=../../storage/coverage/go/json-schema/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
