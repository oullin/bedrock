{
  "name": "@gollin/collection",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../../storage/dist/packages/support/collection && go build ./... && touch ../../../storage/dist/packages/support/collection/.build-stamp'",
    "dev": "go test ./... -count=1",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../../storage/coverage/go/packages-support-collection && go test ./... -coverprofile=../../../storage/coverage/go/packages-support-collection/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
