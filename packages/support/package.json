{
  "name": "@bedrock/support",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../storage/.turbo/dist/support && go build ./... && touch ../../storage/.turbo/dist/support/.build-stamp'",
    "dev": "go test -race ./... -count=1",
    "test": "go test -race ./...",
    "test:coverage": "sh -c 'mkdir -p ../../storage/.cache/coverage/go/support && go test -race ./... -coverprofile=../../storage/.cache/coverage/go/support/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "echo gofmt handled by root go-fmt sweep",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
