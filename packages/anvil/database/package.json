{
  "name": "@bedrock/framework-database",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../../storage/dist/database && go build ./... && touch ../../../storage/dist/database/.build-stamp'",
    "dev": "go test ./... -count=1",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../../storage/coverage/go/database && go test ./... -coverprofile=../../../storage/coverage/go/database/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
