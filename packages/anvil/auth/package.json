{
  "name": "@bedrock/illuminate-auth",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../../storage/.turbo/dist/auth && go build ./... && touch ../../../storage/.turbo/dist/auth/.build-stamp'",
    "dev": "go test ./... -count=1",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../../storage/.cache/coverage/go/auth && go test ./... -coverprofile=../../../storage/.cache/coverage/go/auth/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
