{
  "name": "@gollin/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json --preserveWatchOutput",
    "test": "vitest run --config ../../vitest.workspace.ts --passWithNoTests",
    "test:coverage": "vitest run --config ../../vitest.workspace.ts --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fmt": "oxfmt --ignore-path ../../.gitignore .",
    "fmt:check": "oxfmt --ignore-path ../../.gitignore --check ."
  }
}
