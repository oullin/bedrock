{
  "name": "@bedrock/fortify",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../storage/.turbo/dist/fortify && go build ./... && touch ../../storage/.turbo/dist/fortify/.build-stamp'",
    "dev": "go test ./... -count=1",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../storage/.cache/coverage/go/fortify && go test ./... -coverprofile=../../storage/.cache/coverage/go/fortify/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
