{
  "name": "@bedrock/facades-log",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../../storage/.turbo/dist/facades-log && go build ./... && touch ../../../storage/.turbo/dist/facades-log/.build-stamp'",
    "dev": "go test -race ./... -count=1",
    "test": "go test -race ./...",
    "test:coverage": "sh -c 'mkdir -p ../../../storage/.cache/coverage/go/facades-log && go test -race ./... -coverprofile=../../../storage/.cache/coverage/go/facades-log/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
