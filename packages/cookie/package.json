{
  "name": "@bedrock/framework-cookie",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../storage/dist/cookie && go build ./... && touch ../../storage/dist/cookie/.build-stamp'",
    "dev": "go test ./... -count=1",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../storage/coverage/go/cookie && go test ./... -coverprofile=../../storage/coverage/go/cookie/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
