{
  "name": "@bedrock/money-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vitest --config ../../vitest.package.ts",
    "test": "vitest --config ../../vitest.package.ts run",
    "test:coverage": "vitest --config ../../vitest.package.ts run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fmt": "oxfmt --write src package.json tsconfig.json",
    "fmt:check": "oxfmt --check src package.json tsconfig.json"
  }
}
