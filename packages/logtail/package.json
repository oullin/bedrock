{
  "name": "@bedrock/logtail",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../storage/.turbo/dist/logtail && go build ./... && touch ../../storage/.turbo/dist/logtail/.build-stamp'",
    "dev": "go test -race ./... -count=1",
    "test": "go test -race ./...",
    "test:coverage": "sh -c 'mkdir -p ../../storage/.cache/coverage/go/logtail && go test -race ./... -coverprofile=../../storage/.cache/coverage/go/logtail/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
