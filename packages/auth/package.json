{
  "name": "@gollin/auth",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "sh -c 'mkdir -p ../../storage/dist/packages/auth && go build ./... && touch ../../storage/dist/packages/auth/.build-stamp'",
    "dev": "go test ./... -count=1",
    "test": "go test ./...",
    "test:coverage": "sh -c 'mkdir -p ../../storage/coverage/go/packages-auth && go test ./... -coverprofile=../../storage/coverage/go/packages-auth/coverage.out'",
    "typecheck": "go test ./... -run '^$'",
    "fmt": "gofmt -w .",
    "fmt:check": "sh -c 'test -z \"$(gofmt -l .)\"'"
  }
}
