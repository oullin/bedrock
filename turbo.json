{
  "$schema": "https://turborepo.com/schema.json",
  "cacheDir": "services/storage/.turbo",
  "globalDependencies": [
    ".npmrc",
    "pnpm-lock.yaml",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "../storage/.bin/**",
        "../storage/.turbo/dist/**",
        ".vuepress/dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "../storage/.cache/coverage/**"
      ]
    },
    "fmt": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.json",
        "**/*.md",
        "!**/node_modules/**",
        "!**/storage/.cache/**",
        "!**/storage/.turbo/**",
        "!**/dist/**"
      ],
      "outputs": []
    },
    "fmt:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.go",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.json",
        "**/*.md",
        "!**/node_modules/**",
        "!**/storage/.cache/**",
        "!**/storage/.turbo/**",
        "!**/dist/**"
      ],
      "outputs": []
    }
  }
}
